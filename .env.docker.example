# ==========================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG DOCKER COMPOSE
# Sao chép tệp này thành .env ở thư mục gốc:
# cp .env.docker.example .env
# ==========================================

# 1. Cơ sở dữ liệu MySQL (BẮT BUỘC ĐẶT MẬT KHẨU MẠNH)
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=commerce_os

# 2. Địa chỉ truy cập Frontend & Backend
CLIENT_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# 3. Bảo mật JWT & Cookies (BẮT BUỘC - Tạo chuỗi ngẫu nhiên bằng lệnh: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
COOKIE_SECRET=

# 4. Cloudinary (Lưu trữ ảnh đại diện, ảnh sản phẩm)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# 5. Gửi Email thông báo qua SMTP (Gmail / Resend / SendGrid)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CommerceOS <no-reply@commerceos.vn>

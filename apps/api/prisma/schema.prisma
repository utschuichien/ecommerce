generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------
// Enums
// ----------------------------------------------------

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum Role {
  CUSTOMER
  SELLER
  ADMIN
}

enum ShopStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CLOSED
}

enum ShopMemberRole {
  OWNER
  MANAGER
  STAFF
}

enum ProductStatus {
  DRAFT
  ACTIVE
  HIDDEN
  ARCHIVED
}

enum VariantStatus {
  ACTIVE
  INACTIVE
}

enum InventoryMovementType {
  RESTOCK
  ADJUST
  RESERVE
  RELEASE
  COMMIT
  RETURN
}

enum ReservationStatus {
  ACTIVE
  COMMITTED
  RELEASED
  EXPIRED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  CANCELLED
  EXPIRED
  COMPLETED
}

enum SellerOrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentProvider {
  STRIPE
}

enum PaymentStatus {
  CREATED
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  FAILED
  IGNORED
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

// ----------------------------------------------------
// 1. Identity & Users
// ----------------------------------------------------

model User {
  id              BigInt     @id @default(autoincrement())
  publicId        String     @unique @map("public_id") @db.Char(26)
  email           String     @unique @db.VarChar(255)
  passwordHash    String     @map("password_hash") @db.VarChar(255)
  fullName        String     @map("full_name") @db.VarChar(100)
  phone           String?    @db.VarChar(20)
  avatarUrl       String?    @map("avatar_url") @db.VarChar(500)
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?  @map("email_verified_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  deletedAt       DateTime?  @map("deleted_at")

  roles           UserRole[]
  refreshTokens   RefreshToken[]
  addresses       Address[]
  shopMembers     ShopMember[]
  cart            Cart?
  orders          Order[]
  wishlistItems   WishlistItem[]
  voucherUsages   VoucherUsage[]
  idempotencyKeys IdempotencyKey[]
  reviews         Review[]
  notifications   Notification[]

  @@map("users")
}

model UserRole {
  userId BigInt @map("user_id")
  role   Role

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@map("user_roles")
}

model RefreshToken {
  id           BigInt    @id @default(autoincrement())
  userId       BigInt    @map("user_id")
  familyId     String    @map("family_id") @db.Char(26)
  tokenHash    String    @unique @map("token_hash") @db.Char(64)
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById BigInt?   @map("replaced_by_id")
  userAgent    String?   @map("user_agent") @db.VarChar(500)
  ip           String?   @db.VarChar(45)
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Address {
  id            BigInt   @id @default(autoincrement())
  userId        BigInt   @map("user_id")
  recipientName String   @map("recipient_name") @db.VarChar(100)
  phone         String   @db.VarChar(20)
  line1         String   @db.VarChar(255)
  ward          String   @db.VarChar(100)
  district      String   @db.VarChar(100)
  province      String   @db.VarChar(100)
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

// ----------------------------------------------------
// 2. Shops & Members
// ----------------------------------------------------

model Shop {
  id               BigInt     @id @default(autoincrement())
  publicId         String     @unique @map("public_id") @db.Char(26)
  name             String     @db.VarChar(150)
  slug             String     @unique @db.VarChar(150)
  description      String?    @db.Text
  logoKey               String?    @map("logo_key") @db.VarChar(255)
  bannerKey             String?    @map("banner_key") @db.VarChar(255)
  slogan                String?    @db.VarChar(200)
  status                ShopStatus @default(PENDING)
  flatShippingFee       BigInt     @default(0) @map("flat_shipping_fee")
  enableFreeShipping    Boolean    @default(false) @map("enable_free_shipping")
  freeShippingThreshold BigInt?    @map("free_shipping_threshold")
  pickupContactName     String?    @map("pickup_contact_name") @db.VarChar(100)
  pickupPhone           String?    @map("pickup_phone") @db.VarChar(20)
  pickupAddress         String?    @map("pickup_address") @db.VarChar(255)
  pickupNote            String?    @map("pickup_note") @db.Text
  supportedCarriers     String?    @map("supported_carriers") @db.VarChar(255)
  allowInspection       Boolean    @default(true) @map("allow_inspection")
  dispatchTime          String     @default("24h") @map("dispatch_time") @db.VarChar(10)

  // Chính sách bán hàng & cam kết (Shop Policies)
  holidayMode           Boolean    @default(false) @map("holiday_mode")
  holidayMessage        String?    @map("holiday_message") @db.VarChar(255)
  enableReturn          Boolean    @default(true) @map("enable_return")
  returnPeriodDays      Int        @default(7) @map("return_period_days")
  requireUnboxVideo     Boolean    @default(true) @map("require_unbox_video")
  returnPolicyNote      String?    @map("return_policy_note") @db.Text
  warrantyType          String     @default("shop") @map("warranty_type") @db.VarChar(30)
  warrantyPeriodMonths  Int        @default(12) @map("warranty_period_months")
  warrantyPolicyNote    String?    @map("warranty_policy_note") @db.Text

  reviewedBy       BigInt?    @map("reviewed_by")
  reviewedAt       DateTime?  @map("reviewed_at")
  suspensionReason String?    @map("suspension_reason") @db.Text
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  members      ShopMember[]
  products     Product[]
  sellerOrders SellerOrder[]
  vouchers     Voucher[]

  @@index([status])
  @@map("shops")
}

model ShopMember {
  shopId    BigInt         @map("shop_id")
  userId    BigInt         @map("user_id")
  role      ShopMemberRole @default(OWNER)
  createdAt DateTime       @default(now()) @map("created_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([shopId, userId])
  @@index([userId])
  @@map("shop_members")
}

// ----------------------------------------------------
// 3. Catalog: Brands, Categories, Products, Variants, Images
// ----------------------------------------------------

model Brand {
  id          BigInt    @id @default(autoincrement())
  publicId    String    @unique @map("public_id") @db.Char(26)
  name        String    @db.VarChar(100)
  slug        String    @unique @db.VarChar(100)
  description String?   @db.Text
  logoKey     String?   @map("logo_key") @db.VarChar(255)
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  products    Product[]

  @@map("brands")
}

model Category {
  id       BigInt  @id @default(autoincrement())
  parentId BigInt? @map("parent_id")
  name     String  @db.VarChar(100)
  slug     String  @unique @db.VarChar(100)
  position Int     @default(0)
  isActive Boolean @default(true) @map("is_active")

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@map("categories")
}

model Product {
  id          BigInt        @id @default(autoincrement())
  publicId    String        @unique @map("public_id") @db.Char(26)
  shopId      BigInt        @map("shop_id")
  categoryId  BigInt        @map("category_id")
  brandId     BigInt?       @map("brand_id")
  name        String        @db.VarChar(200)
  slug        String        @db.VarChar(200)
  description String?       @db.Text
  searchText  String?       @map("search_text") @db.Text
  status      ProductStatus @default(DRAFT)
  minPrice    BigInt        @default(0) @map("min_price")
  version     Int           @default(1)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  deletedAt   DateTime?     @map("deleted_at")

  shop     Shop             @relation(fields: [shopId], references: [id], onDelete: Restrict)
  category Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand    Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  variants ProductVariant[]
  images   ProductImage[]
  wishlistItems WishlistItem[]
  reviews  Review[]

  @@unique([shopId, slug])
  @@unique([id, shopId])
  @@index([categoryId, status, id])
  @@index([shopId, status, id])
  @@index([brandId])
  @@map("products")
}

model ProductVariant {
  id             BigInt        @id @default(autoincrement())
  publicId       String        @unique @map("public_id") @db.Char(26)
  productId      BigInt        @map("product_id")
  shopId         BigInt        @map("shop_id")
  sku            String        @db.VarChar(64)
  optionValues   Json?         @map("option_values")
  optionHash     String        @map("option_hash") @db.Char(64)
  price          BigInt
  compareAtPrice BigInt?       @map("compare_at_price")
  currency       String        @default("VND") @db.Char(3)
  status         VariantStatus @default(ACTIVE)
  deletedAt      DateTime?     @map("deleted_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  product      Product                @relation(fields: [productId, shopId], references: [id, shopId], onDelete: Restrict)
  inventory    Inventory?
  cartItems    CartItem[]
  orderItems   OrderItem[]
  reservations InventoryReservation[]
  images       ProductImage[]
  reviews      Review[]

  @@unique([shopId, sku])
  @@unique([productId, optionHash])
  @@map("product_variants")
}

model ProductImage {
  id         BigInt  @id @default(autoincrement())
  productId  BigInt  @map("product_id")
  variantId  BigInt? @map("variant_id")
  storageKey String  @map("storage_key") @db.VarChar(255)
  alt        String? @db.VarChar(255)
  position   Int     @default(0)
  isPrimary  Boolean @default(false) @map("is_primary")

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId, position])
  @@map("product_images")
}

// ----------------------------------------------------
// 4. Inventory, Ledger & Reservations
// ----------------------------------------------------

model Inventory {
  variantId         BigInt   @id @map("variant_id")
  shopId            BigInt   @map("shop_id")
  onHand            Int      @default(0) @map("on_hand")
  reserved          Int      @default(0)
  lowStockThreshold Int?     @map("low_stock_threshold")
  version           Int      @default(1)
  updatedAt         DateTime @updatedAt @map("updated_at")

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@map("inventory")
}

model InventoryMovement {
  id            BigInt                @id @default(autoincrement())
  variantId     BigInt                @map("variant_id")
  shopId        BigInt                @map("shop_id")
  type          InventoryMovementType
  onHandDelta   Int                   @map("on_hand_delta")
  reservedDelta Int                   @map("reserved_delta")
  reason        String?               @db.VarChar(255)
  refType       String?               @map("ref_type") @db.VarChar(50)
  refId         String?               @map("ref_id") @db.VarChar(64)
  actorUserId   BigInt?               @map("actor_user_id")
  createdAt     DateTime              @default(now()) @map("created_at")

  @@unique([variantId, refType, refId, type])
  @@index([variantId, createdAt])
  @@map("inventory_movements")
}

model InventoryReservation {
  id        BigInt            @id @default(autoincrement())
  orderId   BigInt            @map("order_id")
  variantId BigInt            @map("variant_id")
  quantity  Int
  status    ReservationStatus @default(ACTIVE)
  expiresAt DateTime          @map("expires_at")
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([orderId, variantId])
  @@index([status, expiresAt])
  @@map("inventory_reservations")
}

// ----------------------------------------------------
// 5. Carts
// ----------------------------------------------------

model Cart {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @unique @map("user_id")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  cartId     BigInt   @map("cart_id")
  variantId  BigInt   @map("variant_id")
  quantity   Int      @default(1)
  isSelected Boolean  @default(true) @map("is_selected")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@id([cartId, variantId])
  @@map("cart_items")
}

// ----------------------------------------------------
// 6. Ordering & Fulfillment
// ----------------------------------------------------

model Order {
  id              BigInt      @id @default(autoincrement())
  publicId        String      @unique @map("public_id") @db.Char(26)
  orderNumber     String      @unique @map("order_number") @db.VarChar(32)
  userId          BigInt      @map("user_id")
  status          OrderStatus @default(PENDING_PAYMENT)
  subtotal        BigInt
  discountTotal   BigInt      @default(0) @map("discount_total")
  shippingTotal   BigInt      @default(0) @map("shipping_total")
  grandTotal      BigInt      @map("grand_total")
  currency        String      @default("VND") @db.Char(3)
  shippingAddress Json        @map("shipping_address")
  contactEmail    String      @map("contact_email") @db.VarChar(255)
  contactPhone    String      @map("contact_phone") @db.VarChar(20)
  voucherCode     String?     @map("voucher_code") @db.VarChar(32)
  expiresAt       DateTime    @map("expires_at")
  placedAt        DateTime    @default(now()) @map("placed_at")
  paidAt          DateTime?   @map("paid_at")
  cancelledAt     DateTime?   @map("cancelled_at")
  version         Int         @default(1)

  user         User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  sellerOrders SellerOrder[]
  orderItems   OrderItem[]
  reservations InventoryReservation[]
  payments     Payment[]
  voucherUsages VoucherUsage[]
  reviews      Review[]

  @@index([userId, placedAt])
  @@index([status, expiresAt])
  @@map("orders")
}

model SellerOrder {
  id           BigInt            @id @default(autoincrement())
  publicId     String            @unique @map("public_id") @db.Char(26)
  orderId      BigInt            @map("order_id")
  shopId       BigInt            @map("shop_id")
  status       SellerOrderStatus @default(PENDING)
  subtotal     BigInt
  discountTotal BigInt            @default(0) @map("discount_total")
  voucherCode   String?           @map("voucher_code") @db.VarChar(32)
  shippingFee  BigInt            @default(0) @map("shipping_fee")
  total        BigInt
  carrier      String?           @db.VarChar(100)
  trackingCode String?           @map("tracking_code") @db.VarChar(100)
  shippedAt    DateTime?         @map("shipped_at")
  deliveredAt  DateTime?         @map("delivered_at")
  cancelledAt  DateTime?         @map("cancelled_at")
  version      Int               @default(1)

  order      Order       @relation(fields: [orderId], references: [id], onDelete: Restrict)
  shop       Shop        @relation(fields: [shopId], references: [id], onDelete: Restrict)
  orderItems OrderItem[]

  @@unique([orderId, shopId])
  @@index([shopId, status, id])
  @@map("seller_orders")
}

model OrderItem {
  id            BigInt  @id @default(autoincrement())
  orderId       BigInt  @map("order_id")
  sellerOrderId BigInt  @map("seller_order_id")
  shopId        BigInt  @map("shop_id")
  productId     BigInt  @map("product_id")
  variantId     BigInt  @map("variant_id")
  productName   String  @map("product_name") @db.VarChar(200)
  variantLabel  String  @map("variant_label") @db.VarChar(200)
  sku           String  @db.VarChar(64)
  imageKey      String? @map("image_key") @db.VarChar(255)
  unitPrice     BigInt  @map("unit_price")
  quantity      Int
  lineTotal     BigInt  @map("line_total")

  order       Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  sellerOrder SellerOrder    @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict)
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([sellerOrderId])
  @@index([variantId])
  @@map("order_items")
}

// ----------------------------------------------------
// 7. Payments & Webhooks
// ----------------------------------------------------

model Payment {
  id                      BigInt          @id @default(autoincrement())
  publicId                String          @unique @map("public_id") @db.Char(26)
  orderId                 BigInt          @map("order_id")
  provider                PaymentProvider @default(STRIPE)
  status                  PaymentStatus   @default(CREATED)
  providerSessionId       String?         @unique @map("provider_session_id") @db.VarChar(255)
  providerPaymentIntentId String?         @unique @map("provider_payment_intent_id") @db.VarChar(255)
  amount                  BigInt
  currency                String          @default("VND") @db.Char(3)
  failureCode             String?         @map("failure_code") @db.VarChar(50)
  refundedAt              DateTime?       @map("refunded_at")
  version                 Int             @default(1)
  createdAt               DateTime        @default(now()) @map("created_at")
  updatedAt               DateTime        @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("payments")
}

model PaymentWebhookEvent {
  id                BigInt             @id @default(autoincrement())
  provider          PaymentProvider    @default(STRIPE)
  providerEventId   String             @map("provider_event_id") @db.VarChar(64)
  type              String             @db.VarChar(100)
  payload           Json
  providerCreatedAt DateTime?          @map("provider_created_at")
  status            WebhookEventStatus @default(RECEIVED)
  attempts          Int                @default(0)
  error             String?            @db.Text
  receivedAt        DateTime           @default(now()) @map("received_at")
  processedAt       DateTime?          @map("processed_at")

  @@unique([provider, providerEventId])
  @@index([status, receivedAt])
  @@map("payment_webhook_events")
}

// ----------------------------------------------------
// 8. Platform: Idempotency, Outbox, Audit
// ----------------------------------------------------

model IdempotencyKey {
  id             BigInt            @id @default(autoincrement())
  userId         BigInt            @map("user_id")
  scope          String            @db.VarChar(40)
  idemKey        String            @map("idem_key") @db.VarChar(64)
  requestHash    String            @map("request_hash") @db.Char(64)
  status         IdempotencyStatus @default(IN_PROGRESS)
  responseStatus Int?              @map("response_status") @db.SmallInt
  responseBody   Json?             @map("response_body")
  resourceType   String?           @map("resource_type") @db.VarChar(50)
  resourceId     String?           @map("resource_id") @db.VarChar(64)
  lockedUntil    DateTime          @map("locked_until")
  expiresAt      DateTime          @map("expires_at")
  createdAt      DateTime          @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scope, idemKey])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

model OutboxEvent {
  id            BigInt            @id @default(autoincrement())
  aggregateType String            @map("aggregate_type") @db.VarChar(50)
  aggregateId   String            @map("aggregate_id") @db.VarChar(64)
  type          String            @db.VarChar(100)
  payload       Json
  status        OutboxEventStatus @default(PENDING)
  attempts      Int               @default(0)
  availableAt   DateTime          @default(now()) @map("available_at")
  createdAt     DateTime          @default(now()) @map("created_at")
  sentAt        DateTime?         @map("sent_at")

  @@index([status, availableAt, id])
  @@map("outbox_events")
}

model AuditLog {
  id          BigInt   @id @default(autoincrement())
  actorUserId BigInt?  @map("actor_user_id")
  actorRole   String?  @map("actor_role") @db.VarChar(20)
  action      String   @db.VarChar(100)
  targetType  String   @map("target_type") @db.VarChar(50)
  targetId    String   @map("target_id") @db.VarChar(64)
  shopId      BigInt?  @map("shop_id")
  beforeJson  Json?    @map("before_json")
  afterJson   Json?    @map("after_json")
  ip          String?  @db.VarChar(45)
  requestId   String?  @map("request_id") @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([targetType, targetId])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}

model WishlistItem {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  productId BigInt   @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@map("wishlist_items")
}

// ----------------------------------------------------
// 9. Vouchers & Promotions (Global & Shop Vouchers)
// ----------------------------------------------------

enum VoucherScope {
  GLOBAL
  SHOP
}

enum VoucherType {
  FIXED_AMOUNT
  PERCENTAGE
  FREE_SHIPPING
}

model Voucher {
  id                BigInt        @id @default(autoincrement())
  publicId          String        @unique @map("public_id") @db.Char(26)
  code              String        @unique @db.VarChar(32)
  name              String        @db.VarChar(200)
  description       String?       @db.Text
  scope             VoucherScope  @default(GLOBAL)
  shopId            BigInt?       @map("shop_id")
  type              VoucherType   @default(FIXED_AMOUNT)
  discountValue     BigInt        @map("discount_value")
  maxDiscountAmount BigInt?       @map("max_discount_amount")
  minOrderValue     BigInt        @default(0) @map("min_order_value")
  usageLimit        Int           @default(1000) @map("usage_limit")
  usedCount         Int           @default(0) @map("used_count")
  usagePerUser      Int           @default(1) @map("usage_per_user")
  startDate         DateTime      @map("start_date")
  endDate           DateTime      @map("end_date")
  isActive          Boolean       @default(true) @map("is_active")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  shop   Shop?          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  usages VoucherUsage[]

  @@index([scope, shopId, isActive])
  @@index([code, isActive])
  @@map("vouchers")
}

model VoucherUsage {
  id             BigInt   @id @default(autoincrement())
  voucherId      BigInt   @map("voucher_id")
  userId         BigInt   @map("user_id")
  orderId        BigInt?  @map("order_id")
  discountAmount BigInt   @map("discount_amount")
  usedAt         DateTime @default(now()) @map("used_at")

  voucher Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([voucherId, userId])
  @@index([orderId])
  @@map("voucher_usages")
}

model Review {
  id          BigInt          @id @default(autoincrement())
  publicId    String          @unique @map("public_id") @db.Char(26)
  userId      BigInt          @map("user_id")
  productId   BigInt          @map("product_id")
  orderId     BigInt          @map("order_id")
  variantId   BigInt?         @map("variant_id")

  rating      Int             @db.SmallInt
  comment     String?         @db.Text
  images      Json?           @map("images")

  sellerReply String?         @map("seller_reply") @db.Text
  repliedAt   DateTime?       @map("replied_at")

  isVerified  Boolean         @default(true) @map("is_verified")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  product     Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([userId, productId, orderId])
  @@index([productId, rating])
  @@index([userId])
  @@map("reviews")
}

model Notification {
  id        BigInt           @id @default(autoincrement())
  publicId  String           @unique @map("public_id") @db.Char(26)
  userId    BigInt           @map("user_id")
  type      NotificationType @default(SYSTEM)
  title     String           @db.VarChar(255)
  message   String           @db.Text
  link      String?          @db.VarChar(500)
  image     String?          @db.VarChar(500)
  isRead    Boolean          @default(false) @map("is_read")
  readAt    DateTime?        @map("read_at")
  metadata  Json?            @map("metadata")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

enum NotificationType {
  ORDER
  REVIEW
  VOUCHER
  SYSTEM
}



